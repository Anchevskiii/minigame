# ============================================================================
# [REDACTED] — Predloga okoljskih spremenljivk (.env.example)
# VARNOSTNO OPOZORILO: Kopirajte to datoteko v `.env` in vnesite svoje ključe.
# Datoteka `.env` je v `.gitignore` in se NIKOLI ne sme naložiti na GitHub!
# ============================================================================

# Vrata Express zalednega strežnika
PORT=3001
NODE_ENV=development

# Povezava do Supabase PostgreSQL baze (za Prisma ORM — samo na strežniku!)
DATABASE_URL="postgresql://postgres:[GESLO]@db.[PROJEKT].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[GESLO]@db.[PROJEKT].supabase.co:5432/postgres"

# Supabase API ključi na strežniku (SUPABASE_SERVICE_ROLE_KEY nikoli ne izpostavljajte odjemalcu!)
SUPABASE_URL="https://[PROJEKT].supabase.co"
SUPABASE_ANON_KEY="vas-javni-anon-kljuc"
SUPABASE_SERVICE_ROLE_KEY="vas-skrivni-service-role-kljuc"

# Javna konfiguracija za React odjemalca (Vite)
VITE_SUPABASE_URL="https://[PROJEKT].supabase.co"
VITE_SUPABASE_ANON_KEY="vas-javni-anon-kljuc"
VITE_API_BASE_URL="/api"
