# ============================================================================
# [REDACTED] — Predloga okoljskih spremenljivk (.env.example)
# VARNOSTNO OPOZORILO: Kopirajte to datoteko v `.env`.
# Datoteka `.env` je v `.gitignore` in se NIKOLI ne sme naložiti na GitHub!
# ============================================================================

# Vrata Express zalednega strežnika
PORT=3001
NODE_ENV=development
JWT_SECRET="minigame-local-development-secret-key-32chars-min"

# ----------------------------------------------------------------------------
# MOŽNOST 1: Lokalni Docker PostgreSQL (Privzeto za lokalni razvoj)
# Za zagon lokalne baze: `docker compose up postgres -d`
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/redacted_minigame?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/redacted_minigame?schema=public"

# ----------------------------------------------------------------------------
# MOŽNOST 2: Oblačni Supabase (Opcijsko)
# Če želite povezavo z zunanjim Supabase projektom, odkomentirajte spodnje vrstice:
# ----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.[PROJEKT]:[GESLO]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJEKT]:[GESLO]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://[PROJEKT].supabase.co"
# SUPABASE_ANON_KEY="vas-javni-anon-kljuc"
# SUPABASE_SERVICE_ROLE_KEY="vas-skrivni-service-role-kljuc"
# VITE_SUPABASE_URL="https://[PROJEKT].supabase.co"
# VITE_SUPABASE_ANON_KEY="vas-javni-anon-kljuc"

# Javna konfiguracija za React odjemalca (Vite)
VITE_API_BASE_URL="/api"
